# Keep text files LF on every platform so golden SHA fixtures and
# cross-OS CI stay byte-stable. Windows runners otherwise convert to CRLF.
* text=auto eol=lf

# Explicit text types used by this monorepo.
*.go text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Binary artifacts must not be normalized.
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
