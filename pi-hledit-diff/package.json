{
  "name": "pi-hledit-diff",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Pi extension for stale-safe anchored file changes with inline updated anchors and diff rendering.",
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:bundled": "node --test test/cli.test.ts test/anchor-hash.test.ts test/activation.integration.test.ts test/tool-result.integration.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.0",
    "@earendil-works/pi-coding-agent": "0.99.0",
    "@earendil-works/pi-server": "0.99.0",
    "@earendil-works/pi-tui": "0.99.0",
    "@types/node": "^26.1.1",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  }
}
